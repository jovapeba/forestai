# VERDANT AI — environment keys
# Copy to .env.local and fill in what you have. All are free.

# REQUIRED — CARTO Basemaps API key (map canvas tiles; free at carto.com/basemaps/apikey)
VITE_CARTO_API_KEY=

# OPTIONAL — NASA FIRMS MAP_KEY (bbox-scoped fire API; free at firms.modaps.eosdis.nasa.gov/api/area)
VITE_FIRMS_MAP_KEY=

# OPTIONAL — NVE HydAPI key (Norwegian river gauges; free at hydapi.nve.no)
VITE_NVE_API_KEY=

# OPTIONAL — eBird API key (recent real bird observations; free at birding.org / Cornell eBird)
# Not wired into the app yet — see README catalog.
EBIRD_API_KEY=
